{
  "name": "hero-cover",
  "title": "Centered Hero (Cover)",
  "region": "hero",
  "validRegions": ["hero", "page-top"],
  "blocksUsed": [
    "core/cover",
    "core/group",
    "core/heading",
    "core/paragraph",
    "core/buttons",
    "core/button"
  ],
  "tokensAccepted": {
    "color": ["base", "contrast", "primary"],
    "fontSize": ["medium", "xxx-large"],
    "spacing": ["40", "50", "80"]
  },
  "parameterizable": {
    "content": ["heading text", "paragraph text", "button labels", "button URLs"],
    "tokens": ["overlayColor", "text color", "button background/text color", "padding scale"],
    "media": ["cover background image (optional — omit for solid-overlay hero)"],
    "structuralKnobs": ["dimRatio (overlay darkness 0-100)", "minHeight", "constrained contentSize"]
  },
  "locked": [
    "block nesting: cover > inner-container > group(constrained) > [heading, paragraph, buttons]",
    "exactly one h1 (level 1) — this is the page's primary heading",
    "buttons centered via flex layout"
  ],
  "parameterizationRules": [
    "dimRatio is CONDITIONAL on whether a background image is set. With an image: 50-60 (darkens the image for text legibility). With NO image (solid-color hero): 100 (full opacity so the overlay color shows solid). Confirmed via Playground 2026-05-27 — dimRatio 60 with no image renders a washed translucent gray, not a solid hero. The AI must set dimRatio based on the image slot, not freely."
  ],
  "slots": {
    "headingText": {
      "kind": "text",
      "target": { "blockPath": [0, 0, 0], "attribute": "content" }
    },
    "paragraphText": {
      "kind": "text",
      "target": { "blockPath": [0, 0, 1], "attribute": "content" }
    },
    "primaryButtonLabel": {
      "kind": "text",
      "target": { "blockPath": [0, 0, 2, 0], "attribute": "text" }
    },
    "primaryButtonUrl": {
      "kind": "url",
      "target": { "blockPath": [0, 0, 2, 0], "attribute": "url" }
    },
    "secondaryButtonLabel": {
      "kind": "text",
      "target": { "blockPath": [0, 0, 2, 1], "attribute": "text" }
    },
    "secondaryButtonUrl": {
      "kind": "url",
      "target": { "blockPath": [0, 0, 2, 1], "attribute": "url" }
    },
    "overlayColor": {
      "kind": "tokenRef",
      "target": { "blockPath": [0], "attribute": "overlayColor" },
      "bounds": { "vocab": "color" }
    },
    "headingColor": {
      "kind": "tokenRef",
      "target": { "blockPath": [0, 0, 0], "attribute": "textColor" },
      "bounds": { "vocab": "color" }
    },
    "paragraphColor": {
      "kind": "tokenRef",
      "target": { "blockPath": [0, 0, 1], "attribute": "textColor" },
      "bounds": { "vocab": "color" }
    },
    "headingFontSize": {
      "kind": "tokenRef",
      "target": { "blockPath": [0, 0, 0], "attribute": "fontSize" },
      "bounds": { "vocab": "fontSize" }
    },
    "primaryButtonBackground": {
      "kind": "tokenRef",
      "target": { "blockPath": [0, 0, 2, 0], "attribute": "backgroundColor" },
      "bounds": { "vocab": "color" }
    },
    "primaryButtonTextColor": {
      "kind": "tokenRef",
      "target": { "blockPath": [0, 0, 2, 0], "attribute": "textColor" },
      "bounds": { "vocab": "color" }
    },
    "backgroundImage": {
      "kind": "url",
      "target": { "blockPath": [0], "attribute": "url" }
    },
    "dimRatio": {
      "kind": "scalar",
      "target": { "blockPath": [0], "attribute": "dimRatio" },
      "bounds": { "min": 0, "max": 100 }
    },
    "minHeight": {
      "kind": "scalar",
      "target": { "blockPath": [0], "attribute": "minHeight" },
      "bounds": { "min": 30, "max": 100 }
    },
    "contentWidth": {
      "kind": "scalar",
      "target": { "blockPath": [0, 0], "attribute": "layout.contentSize" },
      "bounds": { "enum": ["480px", "560px", "680px", "800px", "960px"] }
    }
  },
  "slotRules": [
    {
      "type": "dimRatioImageDependency",
      "dimRatioSlot": "dimRatio",
      "imageSlot": "backgroundImage",
      "withImage": { "min": 40, "max": 70 },
      "withoutImage": { "min": 100, "max": 100 }
    }
  ],
  "compositionRules": {
    "occursOncePerPage": true,
    "validTemplates": ["front-page", "home", "page"],
    "mustBeFirstInMainOrSecond": true
  },
  "notes": "Distinctiveness comes from token values (overlay color, type scale) + optional background image, NOT from restructuring. The h1 here is the document's single h1; downstream patterns must use h2+. The outline button uses a block style variation (is-style-outline) that the theme.json must register or core provides."
}
