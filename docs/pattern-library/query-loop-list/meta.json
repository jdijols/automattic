{
  "name": "query-loop-list",
  "title": "Post Grid (Query Loop)",
  "region": "content",
  "validRegions": ["content", "home-feed", "archive-feed"],
  "blocksUsed": [
    "core/group",
    "core/heading",
    "core/query",
    "core/post-template",
    "core/post-featured-image",
    "core/post-title",
    "core/post-date",
    "core/post-excerpt",
    "core/query-pagination",
    "core/query-pagination-previous",
    "core/query-pagination-numbers",
    "core/query-pagination-next"
  ],
  "tokensAccepted": {
    "color": ["base", "secondary"],
    "fontSize": ["small", "large", "xx-large"],
    "spacing": ["30", "50", "60", "70"]
  },
  "parameterizable": {
    "content": ["section heading text"],
    "tokens": ["background color", "type scale", "spacing scale", "featured-image border radius"],
    "queryKnobs": ["perPage", "orderBy (date/title/menu_order)", "order (asc/desc)", "postType"],
    "layoutKnobs": ["post-template layout (grid columnCount 1-4 | list)", "which post fields appear + their order"]
  },
  "locked": [
    "query > post-template > [post-* fields] nesting — post-* blocks are ONLY valid inside post-template",
    "query-pagination is a direct child of query, sibling to post-template",
    "headings here are h2/h3 — never h1 (hero owns the single h1)"
  ],
  "slots": {
    "sectionHeadingText": {
      "kind": "text",
      "target": { "blockPath": [0, 0], "attribute": "content" }
    },
    "backgroundColor": {
      "kind": "tokenRef",
      "target": { "blockPath": [0], "attribute": "backgroundColor" },
      "bounds": { "vocab": "color" }
    },
    "headingFontSize": {
      "kind": "tokenRef",
      "target": { "blockPath": [0, 0], "attribute": "fontSize" },
      "bounds": { "vocab": "fontSize" }
    },
    "perPage": {
      "kind": "scalar",
      "target": { "blockPath": [0, 1], "attribute": "query.perPage" },
      "bounds": { "min": 1, "max": 24 }
    },
    "orderBy": {
      "kind": "scalar",
      "target": { "blockPath": [0, 1], "attribute": "query.orderBy" },
      "bounds": { "enum": ["date", "title", "menu_order"] }
    },
    "order": {
      "kind": "scalar",
      "target": { "blockPath": [0, 1], "attribute": "query.order" },
      "bounds": { "enum": ["asc", "desc"] }
    },
    "postType": {
      "kind": "scalar",
      "target": { "blockPath": [0, 1], "attribute": "query.postType" },
      "bounds": { "enum": ["post", "page"] }
    },
    "postTemplateColumns": {
      "kind": "scalar",
      "target": { "blockPath": [0, 1, 0], "attribute": "layout.columnCount" },
      "bounds": { "min": 1, "max": 4 }
    },
    "featuredImageRadius": {
      "kind": "scalar",
      "target": { "blockPath": [0, 1, 0, 0], "attribute": "style.border.radius" },
      "bounds": { "enum": ["0px", "4px", "8px", "12px", "16px"] }
    }
  },
  "compositionRules": {
    "occursOncePerPage": "typically",
    "validTemplates": ["front-page", "home", "index", "archive"],
    "requiresDynamicContext": "post-* blocks resolve against the loop's current post; meaningless outside a query/template context"
  },
  "notes": "This is the IR's hardest case: a DYNAMIC block (query) whose inner post-template is a TEMPLATE applied per-post, not static content. The IR must distinguish 'static subtree' (hero) from 'template subtree applied N times' (post-template). post-* blocks are context-bound — the validator must reject them outside a query/post-template ancestor. inherit:false means this query defines its own params (vs inheriting the template's main query)."
}
