{
  "description": "social-proof page archetype: parameterized three-card testimonials-row pattern (rating, quote, avatar + name/role) + footer pattern with nav",
  "target": "ir",
  "expect": "pass",
  "input": {
    "irVersion": 1,
    "theme": {
      "slug": "chorus-proof",
      "title": "Chorus",
      "description": "A product social-proof page.",
      "wpVersionTarget": "6.6"
    },
    "tokens": {
      "colors": [
        { "slug": "base", "color": "#ffffff" },
        { "slug": "contrast", "color": "#11161d" },
        { "slug": "secondary", "color": "#5b6472" },
        { "slug": "primary", "color": "#e2b35c" }
      ],
      "fontSizes": [
        { "slug": "small", "size": "0.875rem" },
        { "slug": "medium", "size": "1.125rem" },
        { "slug": "xx-large", "size": "2.4rem" }
      ],
      "spacing": [
        { "slug": "30", "size": "0.75rem" },
        { "slug": "40", "size": "1rem" },
        { "slug": "50", "size": "1.5rem" },
        { "slug": "60", "size": "2.5rem" },
        { "slug": "80", "size": "5rem" }
      ]
    },
    "regions": [
      {
        "kind": "template",
        "name": "page",
        "content": [
          {
            "pattern": "testimonials-row",
            "params": {
              "sectionHeadingText": { "kind": "text", "value": "Don't take our word for it" },
              "quote1": { "kind": "text", "value": "It replaced three tools and a weekly status meeting." },
              "author1Name": { "kind": "text", "value": "Avery Quinn" },
              "author1Role": { "kind": "text", "value": "Head of Content, Northwind" },
              "author1AvatarUrl": { "kind": "url", "value": "https://example.com/avatars/avery.jpg" },
              "author2Name": { "kind": "text", "value": "Mira Sol" },
              "quote3": { "kind": "text", "value": "Onboarding took ten minutes." },
              "backgroundColor": { "kind": "tokenRef", "value": "base" },
              "accentColor": { "kind": "tokenRef", "value": "primary" }
            }
          }
        ]
      },
      { "kind": "part", "name": "footer", "content": [{ "pattern": "site-footer" }] }
    ]
  }
}
